# TalkPilot AI Server Configuration

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/talkpilot
JWT_SECRET=talkpilot_ai_super_secret_jwt_key_2026

# Telephony Calling Mode ('mock' for testing, 'real' for live phone calls)
CALLING_MODE=mock

# Telephony Provider Configuration
TELEPHONY_PROVIDER=twilio

# Twilio Credentials (REQUIRED when CALLING_MODE=real)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS Webhook URL (REQUIRED for Twilio status/voice webhooks in real mode)
PUBLIC_WEBHOOK_URL=

# ElevenLabs Text-to-Speech (Human-Like Voice Synthesis)
# Get your API key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# AI Provider Configuration ('gemini', 'groq', 'openai', 'free')
# 'gemini' (Recommended free): get free key at https://aistudio.google.com/
# 'groq' (Recommended fast): get free key at https://console.groq.com/
AI_PROVIDER=free
AI_API_KEY=

# LLM Provider API Keys:
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
OPENAI_API_KEY=

# Client Application URL
CLIENT_URL=http://localhost:3000
