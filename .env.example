# ==============================================================================
# TalkPilot AI — Production & Vercel Environment Variables
# ==============================================================================

# --- Application & Runtime ---
NODE_ENV=production
CLIENT_URL=https://your-project.vercel.app

# --- Database (MongoDB Atlas) ---
# REQUIRED for production: Get a free cluster at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/talkpilot?retryWrites=true&w=majority

# --- Authentication ---
# REQUIRED: A secure random string for JWT token signing
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# --- AI Provider Configuration ---
# Options: 'free', 'gemini', 'groq', 'openai'
# 'free' uses the built-in multi-model zero-setup endpoint (No API key needed!)
AI_PROVIDER=free

# Optional AI API Keys (for enhanced speed and quality):
# Google Gemini (Free tier): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Groq Cloud (Free tier, ultra-fast 200ms): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# OpenAI: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# --- Voice Synthesis (ElevenLabs TTS) ---
# Ultra-realistic AI voice synthesis (Get key at https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Telephony & Phone Calling ---
# Mode: 'mock' (interactive browser testing, zero cost) or 'real' (live PSTN phone calls via Twilio)
CALLING_MODE=mock
TELEPHONY_PROVIDER=twilio

# Twilio Credentials (REQUIRED only when CALLING_MODE=real):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Public Webhook URL for Twilio Status/Voice Webhooks (Set to your Vercel domain):
PUBLIC_WEBHOOK_URL=https://your-project.vercel.app

# --- Frontend Client Build Variables (Optional) ---
# In production on Vercel, API requests automatically route to relative '/api'.
# If you host your backend externally (e.g., Render/Railway), set these:
# REACT_APP_API_URL=https://your-backend.onrender.com/api
# REACT_APP_SERVER_URL=https://your-backend.onrender.com
